# Copy to server/.env for local development. Never commit real values.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/meetiq
JWT_SECRET=replace-with-a-long-random-string
GROQ_API_KEY=gsk_your_key
# Optional. Live diarization uses Deepgram nova-3. If missing, Groq Whisper is used.
DEEPGRAM_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
# Optional. When set, RevenueCat must send Authorization: Bearer <secret>.
REVENUECAT_WEBHOOK_SECRET=
# Set automatically by Render. Used to ping /health every 10 minutes.
RENDER_EXTERNAL_URL=https://meetiq-api.onrender.com
PORT=10000
